# OpenCode 配置样例
# 当前脚本首批已实现：
# - service install / configure / update / uninstall / check
# - config init

# 一、基础安装
# 新装一个工具时，通常只需要：
# 1. 按需修改本文件
# 2. 执行：bash manage.sh service install --tool-name opencode --config ./coding-agents/opencode/local.conf --yes
INSTALL_METHOD=npm
OPENCODE_PACKAGE=opencode-ai@latest

# 二、接入与认证
# 已有环境想迁移到这套最佳实践，通常只需要：
# 1. 按当前真实环境修改本文件
# 2. 执行：bash manage.sh service configure --tool-name opencode --config ./coding-agents/opencode/local.conf --yes

# 三、模型与 provider
DEFAULT_MODEL=anthropic/claude-sonnet-4-6
PROVIDER_DEFAULT=anthropic
PROVIDER_ENV_KEY=
PROVIDER_API_VALUE=
API_BASE_URL=

# 提供商 Key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVEAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI 兼容网关示例：
# DEFAULT_MODEL=openai/gpt-5.4
# PROVIDER_DEFAULT=openai
# PROVIDER_ENV_KEY=SSS_API_KEY
# API_BASE_URL=https://your-openai-compatible.example.com/v1
# PROVIDER_API_VALUE=你的兼容网关 API Key

# 四、运行目录
# 默认会自动跟随当前仓库路径，不再单独创建额外顶层运行目录
BACKUP_ROOT=

# 五、最佳实践初始化
# service install / service configure 会按下面的开关与模式落地最佳实践
# 全局配置默认写入 ~/.config/opencode/opencode.json
# service install / configure 会把默认 npm plugin 写入 opencode.json
ENABLE_DEFAULT_SKILLS=1
ENABLE_DEFAULT_PLUGINS=1
ENABLE_DEFAULT_HOOKS=1
ENABLE_DEFAULT_MCP=1
ENABLE_DEFAULT_AGENTS=1

# 六、最佳实践模式
# 默认先启用通用开发基线，再补 OpenCode 的插件与工作区能力
COMMON_DEFAULT_PACKS=common-core,common-docs-architecture,common-quality,common-backend,common-frontend
TOOL_DEFAULT_PACKS=opencode-core,opencode-workspace

# standard：默认稳态，只启用默认包
# advanced：启用默认包 + 进阶包
# exploration：启用默认包 + 进阶包 + 探索包
MODE=standard

# 建议优先启用 OpenCode 自己的 automation / memory / safety 进阶包，再按需叠加通用进阶包
ENHANCED_PACKS=opencode-automation,opencode-memory,opencode-safety,enhanced-browser-deep,enhanced-long-memory,enhanced-background-agents
EXPERIMENTAL_PACKS=experimental-bleeding-edge

# 七、显式补充项
# 已装后想增强能力，一般优先两步：
# 1. 先把 MODE 改成 advanced 或 exploration
# 2. 再用下面这些显式项补充少量定制能力
# 会在能力包解析结果基础上继续追加
# OpenCode plugin 支持三类写法：
# 1. npm 包名：opencode-supermemory
# 2. 本地 JS/TS 插件路径：./plugins/my-plugin.ts
# 3. 远程来源登记：github:your-org/your-plugin 或 https://github.com/your-org/your-plugin
# 远程来源会进入状态快照，但 OpenCode 官方当前仍以 npm 包或本地 JS/TS 插件文件为准
# *_SPECS: 在模式默认方案之外额外增加
# *_EXCLUDES: 从模式默认方案里排除；适合你保留 standard/advanced，但不想装其中个别项
SKILL_SPECS=
SKILL_EXCLUDES=
PLUGIN_SPECS=
PLUGIN_EXCLUDES=
HOOK_SPECS=
HOOK_EXCLUDES=
MCP_SPECS=
MCP_EXCLUDES=
AGENT_SPECS=
AGENT_EXCLUDES=
