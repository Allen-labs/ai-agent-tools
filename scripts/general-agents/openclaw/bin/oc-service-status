#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/../lib/common.sh"

CFG="${SCRIPT_DIR}/../local.conf"
if [[ ! -f "${CFG}" ]]; then
  CFG="${SCRIPT_DIR}/../conf.example"
fi

[[ -f "${CFG}" ]] || die "未找到配置文件：${SCRIPT_DIR}/../local.conf 或 conf.example"
load_key_value_config "${CFG}" || die "配置文件解析失败：${CFG}"

svc="${SYSTEMD_SERVICE_NAME:-openclaw-gateway}"
exec /usr/bin/systemctl status "${svc}.service" --no-pager
